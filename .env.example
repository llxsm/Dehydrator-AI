# 复制这个文件为 .env.local，填入你自己的 key。不填也能运行（走离线降级）。
# .env.local 已在 .gitignore 里，不会被提交。
#
# ⚠️ 变量名不要加 NEXT_PUBLIC_ 前缀——加了会被打进浏览器，等于公开发布 key。

# ── 方案 A（最通用）：fill 这三行 ──────────────────────────────
# 支持两种传输格式，靠 LLM_FORMAT 指定，或看 baseUrl 里有没有 "anthropic" 自动判断
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_FORMAT=openai

# 换成 OpenAI：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 换成 Claude 原生格式（Anthropic Messages API）：
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-haiku-latest
# LLM_FORMAT=anthropic

# 换成 DeepSeek 的 Anthropic 兼容端点（baseUrl 含 anthropic 会自动识别）：
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_MODEL=deepseek-chat

# ── 方案 B：只填 provider 的 key，自动套默认端点与格式 ─────────
# 以下任意一个即可（优先级低于方案 A）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── 安全阀（不填也有默认值） ────────────────────────────────
MAX_INPUT_CHARS=20000
DAILY_GLOBAL_LIMIT=300
